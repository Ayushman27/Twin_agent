# ============================================================
# Twin Agent Platform — Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_NAME="Twin Agent Platform"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Database 1: Neon PostgreSQL (Identity, Auth, Organizations, Employees) ──
# Required for production identity and multi-tenant persistence.
NEON_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DATABASE?sslmode=require

# ── Database 2: SQLite (AI Agent Subsystem & Transcripts) ──────
# Agent persistence remains in SQLite.
AGENT_DATABASE_URL=sqlite+aiosqlite:///./twin_agent.db
DATABASE_URL=sqlite+aiosqlite:///./twin_agent.db

# ── Security / JWT ───────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_USE_A_LONG_RANDOM_STRING_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── File Storage ──────────────────────────────────────────────
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_BUCKET=twin-agent-uploads
MAX_UPLOAD_SIZE_MB=50

# ── LLM Provider ─────────────────────────────────────────────
# "mock"    → rule-based demo responses (default, no API key needed)
# "openai"  → real OpenAI API (requires LLM_API_KEY)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=512
GEMINI_API_KEY=your_gemini_api_key_here

# ── Email (future) ───────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@twinagent.ai

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ── Telegram Integration ──────────────────────────────────────
# Obtain your token from @BotFather on Telegram.
# NEVER commit the real token. Only add it to your local .env file.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional but recommended: a random secret for webhook header validation.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# Set the same value in both your .env and when calling /api/v1/telegram/setup-webhook.
TELEGRAM_WEBHOOK_SECRET=your_random_webhook_secret_here

# ── Google OAuth & Gmail Integration ──────────────────────────
# Obtain from Google Cloud Console (APIs & Services -> Credentials -> OAuth 2.0 Client ID)
# Application type: Web application
# Authorized redirect URI: http://localhost:8000/api/v1/integrations/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback
